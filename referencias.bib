% ARQUIVO DE REFERENCIAS BIBLIOGRAFICAS - formato BibTeX
%
% Aqui ficam todas as referencias citadas no texto.
%
% Como usar:
%   - Cada referencia tem um "rotulo" (a string entre chaves logo apos a
%     declaracao do tipo).
%   - No texto, voce cita assim:
%       \cite{rotulo}        --> gera: (AUTOR, 2024)
%       \citeonline{rotulo}  --> gera: Autor (2024)
%
% Tipos mais comuns (use "AT" no lugar do simbolo arroba):
%   AT-article        artigo de periodico
%   AT-book           livro
%   AT-incollection   capitulo de livro
%   AT-inproceedings  artigo em anais de congresso
%   AT-phdthesis      tese de doutorado
%   AT-mastersthesis  dissertacao de mestrado
%   AT-misc           outros (site, software, norma tecnica etc.)
%
% Dica: use Zotero, Mendeley ou JabRef para exportar BibTeX automaticamente.

@article{exemplo2024,
  author  = {Sobrenome, Nome and Outro, Autor},
  title   = {Titulo do artigo de exemplo},
  journal = {Nome do Periodico},
  volume  = {12},
  number  = {3},
  pages   = {100--115},
  year    = {2024},
  doi     = {10.1234/exemplo}
}

